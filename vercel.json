{
  "buildCommand": "npm run build:modern && npm run build",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    {
      "source": "/modern",
      "destination": "/modern/dist/host.html"
    },
    {
      "source": "/modern/",
      "destination": "/modern/dist/host.html"
    },
    {
      "source": "/modern/assets/(.*)",
      "destination": "/modern/dist/assets/$1"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
