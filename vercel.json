{
  "buildCommand": "npm run build:modern",
  "outputDirectory": "modern/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/modern",
      "destination": "/host.html"
    },
    {
      "source": "/modern/",
      "destination": "/host.html"
    },
    {
      "source": "/modern/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
