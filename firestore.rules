rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == "paulinhoo2002@gmail.com";
    }

    match /portfolios/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/driveBackupOperations/{operationId} {
      allow get: if isOwner(userId) && operationId.matches('^[a-f0-9]{64}$');
      allow list, update, delete: if false;
      allow create: if isOwner(userId)
        && operationId.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['fileId', 'contentSha256'])
        && request.resource.data.keys().hasAll(['fileId', 'contentSha256'])
        && request.resource.data.fileId is string
        && request.resource.data.fileId.matches('^[A-Za-z0-9_-]{1,200}$')
        && request.resource.data.contentSha256 is string
        && request.resource.data.contentSha256.matches('^[a-f0-9]{64}$');
    }

    match /meta/access {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
