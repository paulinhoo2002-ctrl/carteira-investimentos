rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // M595 (owner decision): financial/admin operations require the OWNER
    // account — verified email paulinhoo2002@gmail.com — AND the path uid to
    // match the caller uid. Any other signed-in user (even on its own uid
    // path) and any unverified account are denied.
    function isOwnerAccount() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == "paulinhoo2002@gmail.com";
    }

    function isOwner(userId) {
      return isOwnerAccount() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isOwnerAccount();
    }

    match /portfolios/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /meta/access {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
