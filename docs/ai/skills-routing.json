{
  "version": 1,
  "processContract": ["Superpowers-first", "Ponytail-full", "Caveman"],
  "modelRouting": {
    "defaultCodex": "GPT-6 Luna Medium",
    "codexEscalation": "GPT-6 Sol Medium",
    "hermesCodingCandidates": ["Poolside Laguna XS 2.1", "GLM-5.3"],
    "effortByTask": {
      "financial": "HIGH",
      "firebase": "HIGH",
      "ui": "MEDIUM",
      "browser": "MEDIUM",
      "backup": "HIGH",
      "security": "HIGH",
      "documentation": "LOW",
      "release": "MEDIUM",
      "skillDiscovery": "LOW"
    },
    "escalationTriggers": ["protected semantics", "security architecture", "uncertain root cause after three reasoned attempts"],
    "availabilityRule": "Verify in the active runtime; catalog presence is not endpoint availability"
  },
  "runtimeAliases": {
    "firebase-security-rules-auditor": ["firebase:firebase-security-rules-auditor"],
    "browser-harness": ["browser-harness:browser-harness"]
  },
  "routes": {
    "financial": { "required": ["doubt-driven-development"], "optional": { "officialSource": "source-driven-development" } },
    "firebase": { "required": ["firebase-security-rules-auditor"], "optional": { "financialBoundary": "doubt-driven-development" } },
    "ui": { "required": ["interface-design"], "optional": { "accessibility": "web-quality-audit", "designSystem": "design-system" } },
    "browser": { "alternatives": [["browser-harness", "playwright"]], "optional": { "domDiagnostics": "browser-testing-with-devtools" } },
    "backup": { "required": ["doubt-driven-development"], "optional": { "independentDiffReview": "caveman-review" } },
    "security": { "required": ["firebase-security-rules-auditor"], "optional": { "officialSource": "source-driven-development" } },
    "documentation": { "required": ["caveman-review"], "optional": { "architectureDiagram": "archify" } },
    "release": { "required": ["verification-before-completion"], "optional": { "gitCloseout": "caveman-commit" } },
    "skillDiscovery": { "required": ["find-skills"], "optional": {} }
  },
  "maxSpecialistSkills": 2,
  "authorization": "NEVER_GRANTED_BY_SELECTION",
  "missionContext": {
    "dimensions": {
      "risk": [
        "standard",
        "elevated",
        "protected-financial",
        "security-sensitive"
      ],
      "domain": [
        "visual",
        "financial",
        "browser",
        "documentation"
      ],
      "phase": [
        "discovery",
        "implementation",
        "validation",
        "review",
        "release"
      ]
    },
    "rules": [
      {
        "when": {
          "risk": "protected-financial"
        },
        "skills": [
          "doubt-driven-development"
        ]
      },
      {
        "when": {
          "risk": "security-sensitive"
        },
        "skills": [
          "firebase-security-rules-auditor"
        ]
      },
      {
        "when": {
          "domain": "visual"
        },
        "skills": [
          "design-system"
        ]
      },
      {
        "when": {
          "domain": "browser"
        },
        "skills": [
          "browser-testing-with-devtools"
        ]
      },
      {
        "when": {
          "phase": "validation"
        },
        "skills": [
          "verification-before-completion"
        ]
      },
      {
        "when": {
          "phase": "review"
        },
        "skills": [
          "caveman-review"
        ]
      }
    ]
  }
}
